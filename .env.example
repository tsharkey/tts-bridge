# Copy to .env and fill in what you use. Every setting is optional.

# 40K VOD Index import (personal integration; most people won't have this).
# The address of a running 40k-vod-index ingest tool (`pnpm ingest`). When set,
# the web app shows "Import both lists from a 40K VOD Index game" under Armies.
# VOD_INGEST_URL=http://localhost:3001

# TTS's Saved Objects folder (Scribe and `army.py build` save armies there), if it isn't in the usual place:
# TTS_SAVED_OBJECTS=~/Documents/My Games/Tabletop Simulator/Saves/Saved Objects

# Reading Force Org and LCT from TTS's mod files (`python3 data.py mods`, or the Data cache page).
# TTS's Workshop folder, if it isn't in the usual place for your system:
# TTS_MODS_DIR=~/Library/Tabletop Simulator/Mods/Workshop
# Which mod to read when you're subscribed to several versions (default: the newest):
# FORCEORG_WORKSHOP_ID=3753014527
# LCT_WORKSHOP_ID=3710681747
